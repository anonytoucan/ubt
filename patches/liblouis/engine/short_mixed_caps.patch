+/* A bounded, opt-in policy for short mixed-case words. Count all cased
+ * letters of the surrounding word, including those before this capitals run. */
+static int
+shortPartialCapsWord(int pos, const TranslationTableHeader *table,
+		const InString *input, const EmphasisClass *class,
+		const unsigned int *wordBuffer) {
+	int count = 0, gap = 0;
+	if (!table->capsPartialWordLimit) return 0;
+	while (pos > 0 && (wordBuffer[pos - 1] & WORD_CHAR)) pos--;
+	for (; pos < input->length && (wordBuffer[pos] & WORD_CHAR); pos++) {
+		if (isEmphasizable(input->chars[pos], table, class)) {
+			/* A symbol between letters is not part of a short alphabetic token. */
+			if (gap || ++count > table->capsPartialWordLimit) return 0;
+		} else if (count) {
+			gap = 1;
+		}
+	}
+	return count > 0;
+}
