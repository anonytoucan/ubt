+    - "⠛⠊⠿"
+  - - "울산"
+    - "⠯⠇⠒"
+  - - "은행"
+    - "⠵⠚⠗⠶"
+  - - "을지"
+    - "⠮⠨⠕"
+  - - "인간"
+    - "⠟⠫⠒"
+
+  # word_abbreviation
+  - - "그래서"
+    - "⠁⠎"
+  - - "그러나"
+    - "⠁⠉"
+  - - "그러면"
+    - "⠁⠒"
+  - - "그러므로"
+    - "⠁⠢"
+  - - "그런데"
+    - "⠁⠝"
+  - - "그리고"
+    - "⠁⠥"
+  - - "그리하여"
+    - "⠁⠱"
+
+  # doubled_onset
+  - - "까지"
+    - "⠠⠫⠨⠕"
+  - - "따라"
+    - "⠠⠊⠐⠣"
+  - - "빠른"
+    - "⠠⠘⠐⠵"
+  - - "싸움"
+    - "⠠⠇⠍⠢"
+  - - "짜다"
+    - "⠠⠨⠊"
+
+  # geot_abbreviation
+  - - "것"
+    - "⠸⠎"
+  - - "것이"
+    - "⠸⠎⠕"
+  - - "것을"
+    - "⠸⠎⠮"
+
+  # compound_coda
+  - - "넓은"
+    - "⠉⠞⠃⠵"
+  - - "겪고"
+    - "⠈⠱⠁⠁⠈⠥"
+  - - "밖에"
+    - "⠘⠁⠁⠝"
+  - - "읽다"
+    - "⠕⠂⠁⠊"
+  - - "삶"
+    - "⠇⠂⠢"
+
+  # vowel_initial
+  - - "이동"
+    - "⠕⠊⠿"
+  - - "안녕"
+    - "⠣⠒⠉⠻"
+  - - "우리"
+    - "⠍⠐⠕"
+  - - "어머니"
+    - "⠎⠑⠎⠉⠕"
+  - - "아이"
+    - "⠣⠕"
+
+  # numbers
+  # A blank cell is inserted between a number and a following syllable
+  # whose initial is ㄴ ㄷ ㅁ ㅋ ㅌ ㅍ ㅎ (their patterns could be read
+  # as digits).
+  - - "2024년"
+    - "⠼⠃⠚⠃⠙ ⠉⠡"
+  - - "100개"
+    - "⠼⠁⠚⠚⠈⠗"
+
+  # Standalone jamo (제9항): 온표 carrier ⠿ + letter form
+  - - "ㄱ"
+    - "⠿⠁"
+  - - "ㅏ"
+    - "⠿⠣"
+
+  # Archaic letters 옛 글자 (제19·21·25항)
+  - - "ㅿ"
+    - "⠿⠐⠅"
+  - - "ㆍ"
+    - "⠿⠐⠼"
