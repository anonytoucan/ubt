+    - "⠘⠊"
+  - - "사람"
+    - "⠇⠐⠣⠢"
+  - - "자리"
+    - "⠨⠐⠕"
+  - - "카드"
+    - "⠋⠊⠪"
+  - - "타자"
+    - "⠓⠨"
+  - - "파도"
+    - "⠙⠊⠥"
+  - - "하늘"
+    - "⠚⠉⠮"
+
+  # vc_abbreviation
+  - - "억울"
+    - "⠹⠯"
+  - - "언어"
+    - "⠾⠎"
+  - - "얼굴"
+    - "⠞⠈⠯"
+  - - "연구"
+    - "⠡⠈⠍"
+  - - "열심"
+    - "⠳⠠⠕⠢"
+  - - "영어"
+    - "⠻⠎"
