+always \x339e 356-13-134-256
+always \x33a1 356-134-45-3456-12
+always \x2113 356-123-256
+always \x338e 356-134-1245-256
+
+# Other punctuation
+punctuation / 456-34
+punctuation ~ 4-35
+punctuation \x2015 36-36
+punctuation \x00b7 5-23
+
